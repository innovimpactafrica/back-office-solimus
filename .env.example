# ═══════════════════════════════════════════════════════════════════════════
# Base MySQL — utilisé par docker-compose (service db) et par Spring (profil docker)
# ═══════════════════════════════════════════════════════════════════════════
DB_HOST=db
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Clé de signature des tokens JWT — générer une valeur aléatoire longue, jamais réutiliser
# cet exemple. Changer cette valeur invalide immédiatement toutes les sessions actives.
JWT_SECRET=your-jwt-secret-example
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

ACTIVATION_CODE_EXPIRATION_MINUTES=15
ACTIVATION_CODE_RESEND_COOLDOWN_SECONDS=30

# ═══════════════════════════════════════════════════════════════════════════
# SMTP — envoi des mails (OTP, reset MDP, etc.)
# ═══════════════════════════════════════════════════════════════════════════
# Hôte SMTP (Gmail, Brevo, etc.)
MAIL_HOST=smtp.gmail.com
# 587 = soumission avec STARTTLS
MAIL_PORT=587
# Compte utilisé pour s'authentifier auprès du serveur SMTP
MAIL_USERNAME=your-email@gmail.com
# Avec Gmail : un "mot de passe d'application" (pas le mot de passe du compte), généré depuis
# myaccount.google.com/apppasswords — nécessite la validation en 2 étapes activée sur le compte
MAIL_PASSWORD=

# Adresse "From" affichée aux destinataires — avec Gmail, DOIT être identique à MAIL_USERNAME
# (ou un alias "Envoyer un message en tant que" vérifié dans les paramètres Gmail), sinon Gmail
# ignore cette valeur et affiche quand même MAIL_USERNAME comme expéditeur
MAIL_FROM=your-email@gmail.com

MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_TRUST=smtp.gmail.com

# ═══════════════════════════════════════════════════════════════════════════
# Front-end / Back-end — liens dans les e-mails et redirections
# ═══════════════════════════════════════════════════════════════════════════
FRONTEND_BASE_URL=http://localhost:4200
BACKEND_BASE_URL=http://localhost:8085
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/create-password?token=
FRONTEND_ACTIVATION_URL=http://localhost:4200/create-password?token=
SYNDIC_WEB_APP_REDIRECT_URL=http://localhost:4200/app/parametres

# ═══════════════════════════════════════════════════════════════════════════
# MinIO — fichiers / images
# ═══════════════════════════════════════════════════════════════════════════
MINIO_URL=https://minio.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=solimus

# ═══════════════════════════════════════════════════════════════════════════
# Divers
# ═══════════════════════════════════════════════════════════════════════════
GEOLOCATION_SEARCH_RADIUS_KM=30.0

# ═══════════════════════════════════════════════════════════════════════════
# TouchPay — paiements Mobile Money
# ═══════════════════════════════════════════════════════════════════════════
TOUCHPAY_AGENCY_CODE=your-agency-code
TOUCHPAY_TOKEN=your-touchpay-token
TOUCHPAY_DOMAIN_NAME=example.com
TOUCHPAY_SUCCESS_REDIRECT_URL=http://localhost:8085/api/payments/intouch/payment-success
TOUCHPAY_FAILED_REDIRECT_URL=http://localhost:8085/api/payments/intouch/payment-failed
TOUCHPAY_DEFAULT_CITY=Dakar
TOUCHPAY_CALLBACK_URL=http://localhost:8085/api/payments/intouch/callback
TOUCHPAY_BRIDGE_URL=http://localhost:8085/touchpay-bridge.html?ref=%s&apiBaseUrl=http://localhost:8085

# ═══════════════════════════════════════════════════════════════════════════
# Firebase — notifications push (contenu JSON brut du fichier de service account)
# ═══════════════════════════════════════════════════════════════════════════
FIREBASE_SERVICE_ACCOUNT_JSON=
