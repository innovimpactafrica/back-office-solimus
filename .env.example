# ════════════════════════════════════════════════════════════════════════════════════════════
# Variables de back-office-solimus (api.solimus.sn) — valeurs FACTICES, à copier en .env (local)
# ou à saisir dans Dokploy > Application > Environment (production).
#
# [OBLIGATOIRE]  sans elle, l'application s'arrête au démarrage avec un ERROR qui la nomme.
# [FACULTATIVE]  absente, la valeur par défaut indiquée s'applique.
# [RECOMMANDÉE]  facultative au démarrage, mais la fonctionnalité citée ne marche pas sans elle.
#
# En production, l'image force le profil Spring « docker » : SPRING_PROFILES_ACTIVE est sans effet.
# Valeurs contenant $ # ' ou des espaces : entre apostrophes.
# ════════════════════════════════════════════════════════════════════════════════════════════

# ── Base PostgreSQL (externe) ──
# [OBLIGATOIRE] hôte PostgreSQL ; « db » avec docker-compose.local-db.yml
DB_HOST=postgres.example.invalid
# [FACULTATIVE] défaut 5432 (profil docker) ; le serveur Solimus écoute sur 5430
DB_PORT=5432
# [OBLIGATOIRE] nom de la base
DB_NAME=solimus_db
# [OBLIGATOIRE] utilisateur de la base
DB_USER=solimus_app
# [OBLIGATOIRE]
DB_PASSWORD=change-me
# [FACULTATIVE] connexions max du pool (base partagée : rester modeste)
#DB_POOL_SIZE=8
# [FACULTATIVE] délai du contrôle de démarrage
#DB_CONNECT_TIMEOUT_SECONDS=10
# [FACULTATIVE] false désactive le contrôle de la base au démarrage
#APP_STARTUP_DB_CHECK=true

# ── JWT ──
# [OBLIGATOIRE] 32 octets minimum ; le changer déconnecte tout le monde
JWT_SECRET=change-me-at-least-32-bytes-random-value
# [FACULTATIVE] ms, défaut 3600000 (1 h) en profil docker
#JWT_EXPIRATION=3600000
# [FACULTATIVE] ms, défaut 7 jours
#JWT_REFRESH_EXPIRATION=604800000
# [FACULTATIVE] défaut 15
#ACTIVATION_CODE_EXPIRATION_MINUTES=15
# [FACULTATIVE] défaut 30
#ACTIVATION_CODE_RESEND_COOLDOWN_SECONDS=30

# ── Mail (SMTP) — un SMTP injoignable n'empêche ni le démarrage ni la liveness ──
# [FACULTATIVE] défaut ssl0.ovh.net
MAIL_HOST=smtp.example.invalid
# [FACULTATIVE] défaut 587
MAIL_PORT=587
# [RECOMMANDÉE] envoi des e-mails
MAIL_USERNAME=contact@example.invalid
# [RECOMMANDÉE] envoi des e-mails
MAIL_PASSWORD=change-me
# [FACULTATIVE] défaut contact@solimus.sn
MAIL_FROM=contact@example.invalid
# [FACULTATIVE] défaut Solimus
#MAIL_APP_NAME=Solimus
# [FACULTATIVE] défaut true
#MAIL_SMTP_AUTH=true
# [FACULTATIVE] défaut true
#MAIL_SMTP_STARTTLS=true
# [FACULTATIVE] défaut true
#MAIL_SMTP_STARTTLS_REQUIRED=true
# [FACULTATIVE] défaut ssl0.ovh.net
#MAIL_SMTP_SSL_TRUST=ssl0.ovh.net

# ── URLs publiques (liens des e-mails, redirections) ──
# [RECOMMANDÉE] défaut https://solimus.example.com/
FRONTEND_BASE_URL=https://app.example.invalid/
# [RECOMMANDÉE] défaut https://api.solimus.example.com
BACKEND_BASE_URL=https://api.example.invalid
# [RECOMMANDÉE]
FRONTEND_RESET_PASSWORD_URL=https://app.example.invalid/create-password?token=
# [RECOMMANDÉE]
FRONTEND_ACTIVATION_URL=https://app.example.invalid/create-password?token=
# [FACULTATIVE] défaut https://syndic.solimus.sn/app/parametres
#SYNDIC_WEB_APP_REDIRECT_URL=https://syndic.example.invalid/app/parametres

# ── MinIO — clés vides : stockage désactivé avec un WARN (le démarrage continue) ──
# [RECOMMANDÉE] fichiers et images
MINIO_URL=https://minio.example.invalid
# [RECOMMANDÉE]
MINIO_ACCESS_KEY=change-me
# [RECOMMANDÉE]
MINIO_SECRET_KEY=change-me
# [FACULTATIVE] défaut solimussyndic
MINIO_BUCKET=solimussyndic

# ── Firebase (notifications push) — contenu JSON brut du compte de service, sur une ligne ──
# [RECOMMANDÉE] vide : notifications push désactivées avec un WARN
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── TouchPay (page de paiement hébergée, bridge) ──
# [RECOMMANDÉE] paiement par page hébergée (plus de valeur factice par défaut)
TOUCHPAY_AGENCY_CODE=change-me
# [RECOMMANDÉE] idem
TOUCHPAY_TOKEN=change-me
# [FACULTATIVE] défaut : script de production TouchPay
#TOUCHPAY_HOSTED_SCRIPT_URL=
# [FACULTATIVE] défaut solimus.net
#TOUCHPAY_DOMAIN_NAME=solimus.net
# [FACULTATIVE] défaut Dakar
#TOUCHPAY_DEFAULT_CITY=Dakar
# [FACULTATIVE] défaut https://api.solimus.sn/api/payments/intouch/payment-success
#TOUCHPAY_SUCCESS_REDIRECT_URL=
# [FACULTATIVE] défaut https://api.solimus.sn/api/payments/intouch/payment-failed
#TOUCHPAY_FAILED_REDIRECT_URL=
# [FACULTATIVE] défaut https://api.solimus.sn/api/payments/intouch/callback
#TOUCHPAY_CALLBACK_URL=
# [FACULTATIVE] défaut https://api.solimus.sn/touchpay-bridge.html?ref=%s&apiBaseUrl=https://api.solimus.sn
#TOUCHPAY_BRIDGE_URL=

# ── API TouchPay GU (paiements directs Wave / Orange Money) — absentes : l'API répond
#    « Paiement ... non configuré » (HTTP 502 JSON de l'application, différent du 502 de Traefik) ──
# [RECOMMANDÉE]
GUTOUCH_AGENCY_CODE=change-me
# [RECOMMANDÉE]
GUTOUCH_LOGIN_AGENT=change-me
# [RECOMMANDÉE]
GUTOUCH_PASSWORD_AGENT=change-me
# [RECOMMANDÉE]
GUTOUCH_DIGEST_USERNAME=change-me
# [RECOMMANDÉE]
GUTOUCH_DIGEST_PASSWORD=change-me
# [FACULTATIVE]
#GUTOUCH_API_BASE_URL=https://api.gutouch.com/dist/api/touchpayapi/v1
# [FACULTATIVE]
#GUTOUCH_HTTP_METHOD=PUT
# [FACULTATIVE]
#GUTOUCH_PARTNER_NAME=Solimus
# [FACULTATIVE] vide : code par défaut du code Java
#GUTOUCH_SERVICE_CODE_WAVE=
# [FACULTATIVE] vide : code par défaut du code Java
#GUTOUCH_SERVICE_CODE_OM=
# [FACULTATIVE]
#GUTOUCH_READ_TIMEOUT_MS=60000
# [FACULTATIVE]
#GUTOUCH_BACKEND_BASE_URL=https://api.solimus.sn
# [FACULTATIVE]
#GUTOUCH_SYNDIC_RETURN_URL=https://syndic.solimus.sn/app/parametres
# [FACULTATIVE]
#GUTOUCH_ADMIN_RETURN_URL=https://bo.solimus.sn
# [FACULTATIVE]
#GUTOUCH_ADMIN_SYNDIC_CREATED_RETURN_URL=https://bo.solimus.sn/syndics

# ── Divers ──
# [FACULTATIVE]
#GEOLOCATION_SEARCH_RADIUS_KM=30.0
# Compte admin créé UNIQUEMENT si aucun admin n'existe en base (premier démarrage) :
# [FACULTATIVE] défaut codé en dur dans DataInitializer
#ADMIN_DEFAULT_EMAIL=admin@example.invalid
# [RECOMMANDÉE sur base vide] sinon mot de passe par défaut connu
#ADMIN_DEFAULT_PASSWORD=change-me
# [FACULTATIVE] défaut de l'image
#JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Duser.timezone=UTC
